    ],
    "alpha_beta_gold_values": [
      "abt_gold"
    ],
    "silver_only_values": [
      "gdt_silver"
    ],
    "invalid_cdr3_tokens": [
      "",
      "na",
      "nan",
      "none",
      "null",
      "unknown",
      "<na>"
