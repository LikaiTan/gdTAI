    "donor_pseudobulk_de": {
      "enabled": true,
      "comparison": "cluster_vs_rest_within_donor",
      "minimum_cells_per_donor_cluster": 10,
      "minimum_paired_donors": 3,
      "minimum_total_counts_per_gene": 20,
      "normalization_target": 1000000,
      "pseudocount": 0.5,
      "gene_chunk_size": 2000,
      "tcr_gene_prefixes_excluded": [
        "TRA",
        "TRB",
        "TRG",
        "TRD"
      ]
    },
    "separate_tcr_expression": {
      "gene_prefixes": [
        "TRDV",
        "TRGV"
      ],
      "normalization_target": 1000000,
      "minimum_cells_per_donor_cluster": 10
    }
  }
