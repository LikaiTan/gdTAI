    ],
    "n_hidden": 128,
    "n_latent": 30,
    "n_layers": 2,
    "dropout_rate": 0.1,
    "dispersion": "gene-batch",
    "gene_likelihood": "nb",
    "max_epochs": 120,
    "batch_size": 1024,
    "early_stopping": true,
    "early_stopping_patience": 15,
    "accelerator": "auto",
    "devices": "auto",
    "training_seed": 20260806,
    "latent_key": "X_scVI_gdT"
  },
  "embedding_clustering": {
    "n_neighbors": 30,
    "metric": "euclidean",
    "umap_min_dist": 0.3,
    "umap_spread": 1.0,
    "seeds": [
      20260806,
      20260817,
      20260829
    ],
    "leiden_resolutions": [
      0.4,
      0.7,
      1.0,
      1.3
    ],
    "primary_seed": 20260806,
    "primary_resolution": 0.7,
    "primary_cluster_key": "gdt_leiden"
  },
  "analysis": {
    "study_column": "source_gse_id",
    "sample_column": "sample_id",
    "library_column": "library_id",
    "donor_column": "donor_id",
    "condition_column": "condition",
    "tissue_column": "tissue_corrected",
    "cluster_column": "gdt_leiden",
    "targeted_cohort_exclusion": {
      "required_boolean_column": "atlas_targeted_cohort",
      "source_ids": [
        "GDT_2020AUG_woCOV",
        "GDTlung2023july_7p",
        "MalteGDT"
      ],
      "exclude_from_abundance_inference": true,
      "exclude_from_primary_de": false
    },
    "composition": {
      "minimum_cells_per_sample": 20,
      "minimum_cells_per_donor": 30,
      "minimum_donors_per_group": 3,
      "continuity_offset": 0.5
    },
    "within_study_contrasts": [
      {
        "contrast_id": "disease_vs_control_template",
        "enabled": false,
        "study_ids": [],
        "group_column": "condition",
        "case_values": [],
        "reference_values": [],
        "paired_by_donor": false,
        "note": "Enable only after exact study-level condition mappings are reviewed on the approved rebuilt object."
      }
    ],
    "random_effects_meta_analysis": {
      "method": "dersimonian_laird",
      "minimum_studies": 2,
      "confidence_level": 0.95
