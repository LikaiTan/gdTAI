      "paired_gamma_delta": "has_TRG_TRD_paired",
      "trg_cdr3": "TRG_cdr3",
      "trd_cdr3": "TRD_cdr3",
      "truth_class": "gdt_truth_class",
      "high_confidence_nk": "atlas_high_confidence_nk",
