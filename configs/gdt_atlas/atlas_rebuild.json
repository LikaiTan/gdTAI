      "donor_id",
      "condition",
      "tissue_corrected",
      "technology_simple",
      "atlas_targeted_cohort",
      "has_TRA_TRB_paired",
      "has_any_ab_tcr",
      "has_TRG_TRD_paired",
      "TRG_cdr3",
      "TRD_cdr3",
      "gdt_truth_class",
      "atlas_high_confidence_nk",
      "atlas_doublet",
      "atlas_non_t_contaminant",
      "atlas_severe_qc_failure"
    ]
  },
  "feature_selection": {
    "flavor": "seurat_v3",
    "batch_key": "source_gse_id",
    "candidate_pool_size": 8000,
    "n_top_genes": 4000,
    "tcr_gene_prefixes_excluded": [
      "TRA",
      "TRB",
      "TRG",
      "TRD"
    ]
  },
  "scvi": {
    "batch_key": "source_gse_id",
    "categorical_covariate_keys": [
